# Server
PORT=4000
NODE_ENV=development

# Mongo (local)
MONGO_URI=mongodb://127.0.0.1:27017/fittrack

# CORS origin (Angular dev server)
CORS_ORIGIN=http://localhost:4200

# Firebase Admin: path to service account JSON downloaded from Firebase console
# (Project settings -> Service accounts -> Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Alternative: paste the JSON directly (one line) instead of pointing to a file
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional: restrict accepted Firebase project id
FIREBASE_PROJECT_ID=your-firebase-project-id
